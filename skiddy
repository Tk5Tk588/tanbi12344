Commands.fog = function(args)
    local remote = ensureF3X()
    if not remote then
        return
    end

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end

    args = tostring(args or "")
    local amount, r, g, b = args:match("^(%d+)%s+(%d+)%s+(%d+)%s+(%d+)$")

    amount = math.clamp(tonumber(amount) or 1, 1, 5)
    r = math.clamp(tonumber(r) or 180, 0, 255)
    g = math.clamp(tonumber(g) or 180, 0, 255)
    b = math.clamp(tonumber(b) or 180, 0, 255)

    local function invoke(...)
        local callArgs = {...}
        local ok, result = pcall(function()
            return remote:InvokeServer(unpack(callArgs))
        end)
        return ok, result
    end

    local base = root.Position
    local fogColor = Color3.fromRGB(r, g, b)

    for i = 0, amount - 1 do
        local cf = CFrame.new(
            math.floor(base.X),
            math.floor(base.Y) + i,
            math.floor(base.Z)
        )

        local ok, part = invoke("CreatePart", "Normal", cf, workspace)

        if ok and typeof(part) == "Instance" then
            invoke("SetName", {part}, "Fog")
            invoke("SyncColor", {{
                Part = part,
                Color = fogColor
            }})

            invoke("SyncMaterial", {{
                Part = part,
                Material = Enum.Material.ForceField
            }})
            invoke("SyncCollision", {{
                Part = part,
                CanCollide = false
            }})
            invoke("SyncResize", {{
                Part = part,
                CFrame = part.CFrame,
                Size = Vector3.new(2048, 0.01, 2048)
            }})
        end

        task.wait()
    end
end
