Commands.clone = function(targetName)
    local remote = ensureF3X()
    if not remote then return end

    targetName = targetName or "me"
    local targets = getTargets(targetName)
    if #targets == 0 then return end

    local function invoke(...)
        local args = {...}
        local ok,result = pcall(function()
            if remote:IsA("RemoteEvent") then
                return remote:FireServer(unpack(args))
            end
            return remote:InvokeServer(unpack(args))
        end)
        return ok,result
    end

    for _,target in ipairs(targets) do
        local character = target.Character
        if character then
            local parts = {}

            for _,obj in ipairs(character:GetDescendants()) do
                if obj:IsA("BasePart") then
                    parts[#parts+1] = {
                        part=obj,
                        cframe=obj.CFrame,
                        anchored=obj.Anchored
                    }
                end
            end

            for _,data in ipairs(parts) do
                invoke("SyncAnchor",{{Part=data.part,Anchored=true}})
            end

            for _,data in ipairs(parts) do
                local ok,clones=invoke("Clone",{data.part},workspace)

                if ok and clones then
                    if typeof(clones)=="Instance" and clones:IsA("BasePart") then
                        invoke("SyncMove",{{Part=clones,CFrame=data.cframe}})
                        invoke("SyncAnchor",{{Part=clones,Anchored=true}})
                    elseif type(clones)=="table" then
                        for _,clone in ipairs(clones) do
                            if typeof(clone)=="Instance" and clone:IsA("BasePart") then
                                invoke("SyncMove",{{Part=clone,CFrame=data.cframe}})
                                invoke("SyncAnchor",{{Part=clone,Anchored=true}})
                            end
                        end
                    end
                end
            end

            for _,data in ipairs(parts) do
                if data.part and data.part.Parent then
                    invoke("SyncAnchor",{{Part=data.part,Anchored=data.anchored}})
                end
            end
        end
    end
end

