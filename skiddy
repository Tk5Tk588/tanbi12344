            Scale = Vector3.new(9000, 9000, 9000)
        }}
    )

    invoke(
        "SyncMesh",
        {{
            Part = part,
            MeshId = "rbxassetid://111891702759441"
        }}
    )

    task.spawn(function()
        while part and part.Parent do
            for _, imageId in ipairs(images) do
                if not part or not part.Parent then
                    break
                end

