local function ensureF3X()
	local remote = getRemote()

	if remote then
		return remote
	end

	chat("f3x me\n")

	local start = os.clock()

	while os.clock() - start < 3 do
		remote = getRemote()

		if remote then
			return remote
		end

		task.wait(0.1)
	end

	chat("btools me\n")

	start = os.clock()

	while os.clock() - start < 3 do
		remote = getRemote()

		if remote then
			return remote
		end

		task.wait(0.1)
	end

	notify(
		"F3X Request Cancelled",
		"Building Tools could not be obtained. The command was cancelled."
	)

	return nil
end

local function getTargets(name)
	name = string.lower((name or ""):gsub("^%s+", ""):gsub("%s+$", ""))
	local players = Players:GetPlayers()

	if name == "me" then
		return {LocalPlayer}
	end

	if name == "all" then
		return players
	end

	if name == "others" then
		local result = {}

		for _, player in ipairs(players) do
			if player ~= LocalPlayer then
				table.insert(result, player)
			end
		end

		return result
	end

	if name == "random" then
		local result = {}

		for _, player in ipairs(players) do
			if player ~= LocalPlayer then
				table.insert(result, player)
			end
		end

		if #result > 0 then
			return {result[math.random(1, #result)]}
		end

		return {}
	end

	local result = {}

	for _, player in ipairs(players) do
		local username = string.lower(player.Name)
		local displayName = string.lower(player.DisplayName)

		if username == name or displayName == name then
			table.insert(result, player)
		end
	end

	if #result > 0 then
		return result
	end

	for _, player in ipairs(players) do
		local username = string.lower(player.Name)
		local displayName = string.lower(player.DisplayName)

		if username:sub(1, #name) == name or displayName:sub(1, #name) == name then
			table.insert(result, player)
		end
	end

	return result
end

