local function executeCommand(text)
	text = text:gsub("^%s+", ""):gsub("%s+$", "")

	local command, target = text:match("^!?([%w_]+)%s*(.*)$")

	if not command then
		return
	end

	command = string.lower(command)

	if target == "" then
		target = nil
	end

	local callback = Commands[command]

	if callback then
		callback(target)
	end
end

